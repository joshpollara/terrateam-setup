# Example .env file generated by terrateam-setup
# This file is created after successful setup

# GitHub App Credentials (when using --github)
GITHUB_APP_ID=123456
GITHUB_APP_INSTALLATION_ID=12345678
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_CLIENT_ID=Iv1.1234567890abcdef
GITHUB_APP_CLIENT_SECRET=1234567890abcdef1234567890abcdef12345678

# OR

# GitLab Credentials (when using --gitlab)
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
GITLAB_WEBHOOK_SECRET=your_webhook_secret_here
GITLAB_URL=https://gitlab.com
